<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <ReleaseDate>2026-10-30</ReleaseDate>
    <Product>英雄联盟数据提取工具</Product>
    <Authors>Nelson</Authors>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- Read at runtime by AppInfo so the UI never shows a stale version. -->
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>
</Project>
