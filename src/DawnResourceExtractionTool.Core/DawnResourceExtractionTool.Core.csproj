<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every localization file is embedded: one key per line, both languages side by side. -->
    <EmbeddedResource Include="Localization\strings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The classifier is internal on purpose; its rules are tested directly. -->
    <InternalsVisibleTo Include="DawnResourceExtractionTool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="LeagueToolkit" Version="3.0.3" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
