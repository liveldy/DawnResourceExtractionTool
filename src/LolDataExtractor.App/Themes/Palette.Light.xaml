<!--
    白天配色。所有键与 Palette.Dark.xaml 一一对应，运行期整本字典替换即可切换主题；
    XAML 里引用这些笔刷必须用 DynamicResource，用 StaticResource 换不掉。
    后半段是 HandyControl 自己的笔刷键：它把这些键放进了 Theme.xaml，换皮肤字典改不动，
    只能由排在最后的本字典覆盖（实测 RegionBrush 等确实跟着走）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底色与面板 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F2F4F7" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorder" Color="#E4E7EC" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#F7F9FC" />
    <SolidColorBrush x:Key="SubtleBackground" Color="#FBFCFD" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="StrongTextBrush" Color="#101828" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#1D2939" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#344054" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#475467" />
    <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#98A2B3" />

    <!-- 输入框与进度条 -->
    <SolidColorBrush x:Key="FieldBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBorder" Color="#D0D5DD" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#E4E7EC" />

    <!-- 提示与警告 -->
    <SolidColorBrush x:Key="HintBackground" Color="#FEF0C7" />
    <SolidColorBrush x:Key="WarningBackground" Color="#FFF7E6" />
    <SolidColorBrush x:Key="WarningBorder" Color="#FDE6B8" />
    <SolidColorBrush x:Key="WarningText" Color="#B54708" />
    <SolidColorBrush x:Key="WarningStrongText" Color="#8A5A00" />

    <!-- 3D 预览 -->
    <SolidColorBrush x:Key="ViewportBackground" Color="#F1F4F9" />
    <SolidColorBrush x:Key="ViewportOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ViewportBorder" Color="#E1E6EF" />

    <!-- 关于弹层的遮罩 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />

    <!-- 栏与栏之间的拖动条：平时看不见，按住才亮起来提示位置 -->
    <SolidColorBrush x:Key="SplitterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#DCE2EC" />

    <!-- HandyControl 控件用的键 -->
    <SolidColorBrush x:Key="RegionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DefaultBrush" Color="#FFFFFF" />
    <!-- 选中行的底色（HandyControl 的 TreeViewItem 选中态用它） -->
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="#DCE6F5" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D5DD" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#101828" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#475467" />
    <SolidColorBrush x:Key="TitleBrush" Color="#101828" />
    <SolidColorBrush x:Key="TextIconBrush" Color="#344054" />
    <SolidColorBrush x:Key="ReverseTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#1F5AD0" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#DCE8FF" />
</ResourceDictionary>
