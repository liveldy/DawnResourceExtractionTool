<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LolDataExtractor.Core\LolDataExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <!-- Window, taskbar and Explorer icon; the PNG is the in-app header logo. -->
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <!-- 开局页的背景视频：仓库根目录的 load.mp4，拷到 exe 旁边；没有这个文件就不放开局页。 -->
  <ItemGroup Condition="Exists('..\..\load.mp4')">
    <Content Include="..\..\load.mp4" Link="load.mp4"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native libraries ship in runtimes\<rid>; this puts that folder on the loader path first. -->
  <ItemGroup>
    <Compile Include="..\LolDataExtractor.Shared\NativeSearchPath.cs" Link="NativeSearchPath.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LolDataExtractor</AssemblyName>
    <RootNamespace>LolDataExtractor.App</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
