<Window x:Class="LolDataExtractor.App.Controls.EntryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择条目"
        Height="560" Width="780" MinHeight="380" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#F2F4F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="Header" Text="选择条目" Style="{StaticResource SectionTitle}"
                               Margin="0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Summary" Text="" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </DockPanel>

                <TextBox Grid.Row="1" x:Name="SearchBox" Height="30" VerticalContentAlignment="Center"
                         Style="{StaticResource PlaceholderTextBox}"
                         Tag="按路径或哈希搜索" TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,10" Padding="4">
            <ListBox x:Name="List" BorderThickness="0" FontSize="12" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,2"
                                   ToolTip="{Binding Path}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="取消" Width="80" Style="{StaticResource SecondaryAction}" Click="Cancel_Click" />
                <Button Content="选择" Width="96" Margin="8,0,0,0" Style="{StaticResource PrimaryAction}"
                        Click="Accept_Click" />
            </StackPanel>
            <TextBlock Text="双击条目可直接选择" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
    </Grid>
</Window>
