<UserControl x:Class="LolDataExtractor.App.Controls.JsonViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HintText" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource PlaceholderBrush}" TextTrimming="CharacterEllipsis"
                       Text="Ctrl+F 搜索 · 点 /lol-game-data/ 路径跳到该资源" />
            <Button Grid.Column="1" x:Name="ModeButton" Content="原文" Width="54" Height="22"
                    FontSize="10" Padding="0" VerticalContentAlignment="Center"
                    Click="ModeButton_Click"
                    ToolTip="在格式化后的 JSON 和客户端原始文本之间切换" />
        </Grid>

        <avalonedit:TextEditor Grid.Row="1" x:Name="Editor"
                               FontFamily="Consolas" FontSize="11"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                               Background="{DynamicResource FieldBackground}"
                               IsReadOnly="True"
                               ShowLineNumbers="True" />
    </Grid>
</UserControl>
