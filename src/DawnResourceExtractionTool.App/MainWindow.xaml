<Window x:Class="DawnResourceExtractionTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:DawnResourceExtractionTool.App.ViewModels"
        xmlns:controls="clr-namespace:DawnResourceExtractionTool.App.Controls"
        xmlns:core="clr-namespace:DawnResourceExtractionTool.Core;assembly=DawnResourceExtractionTool.Core"
        xmlns:loc="clr-namespace:DawnResourceExtractionTool.App.Localization"
        Title="{loc:Loc App.Title}"
        Height="900" Width="1500" MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/logo.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：图标、标题、游戏目录、哈希表状态 -->
        <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.ico" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Ui.Main.Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock Text="{Binding AppSummary}" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="420" Height="32" VerticalContentAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Text="{Binding DataRootText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{loc:Loc Ui.Main.DataRoot.Placeholder}"
                                 KeyDown="DataRootBox_KeyDown"
                                 ToolTip="{loc:Loc Ui.Main.DataRoot.Hint}" />
                        <Button Padding="6,0" Content="{loc:Loc Ui.Main.DataRoot.Browse}" Margin="6,0,0,0" MinWidth="60"
                                Style="{StaticResource SecondaryAction}" Command="{Binding BrowseRootCommand}" />
                        <Button Padding="6,0" Content="{loc:Loc Ui.Main.DataRoot.Scan}" Margin="6,0,0,0" MinWidth="80"
                                Style="{StaticResource PrimaryAction}" Command="{Binding ScanCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding HashStatus}" FontSize="11" Margin="12,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Padding="6,0" Content="{loc:Loc Ui.Main.Toolbar.DownloadHashes}" Style="{StaticResource SecondaryAction}"
                            Command="{Binding DownloadHashesCommand}" />
                    <Button Padding="6,0" Content="{loc:Loc Ui.Main.About.Button}" MinWidth="60" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryAction}"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="{loc:Loc Ui.Main.About.Hint}" />
                    <!-- 方形图标按钮轮流切 黑夜 / 白天 / 跟随系统，选择记在 settings.json 里 -->
                    <Button Width="30" Padding="0" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryAction}"
                            Command="{Binding CycleThemeCommand}"
                            ToolTip="{Binding ThemeHint}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{Binding ThemeIcon}" Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <!-- 方形图标按钮在 中文 / English 之间切换，选择记在 settings.json 里 -->
                    <Button Width="30" Padding="0" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryAction}"
                            Command="{Binding CycleLanguageCommand}"
                            ToolTip="{Binding LanguageHint}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{Binding LanguageIcon}" Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：三栏，栏与栏之间是 10px 的可拖动分隔条 -->
        <Grid Grid.Row="1" x:Name="ColumnGrid" SizeChanged="ColumnGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WadColumn" Width="290" MinWidth="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition x:Name="TreeColumn" Width="*" MinWidth="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition x:Name="PreviewColumn" Width="440" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- wad 列表 -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc Ui.Main.Wads.Title}" Style="{StaticResource SectionTitle}" />

                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SelectAllLabel}" MinWidth="64" Style="{StaticResource SecondaryAction}"
                                    Command="{Binding SelectAllCommand}"
                                    ToolTip="{loc:Loc Ui.Main.Wads.SelectAllHint}" />
                            <Button Padding="6,0" Content="{loc:Loc Ui.Main.Wads.Clear}" MinWidth="54" Margin="6,0,0,0" Style="{StaticResource SecondaryAction}"
                                    Command="{Binding SelectNoneCommand}"
                                    ToolTip="{loc:Loc Ui.Main.Wads.ClearHint}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectionSummary}" FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionSummary}" />
                    </DockPanel>

                    <TextBox Grid.Row="2" Height="28" Margin="0,0,0,6" VerticalContentAlignment="Center"
                             Style="{StaticResource PlaceholderTextBox}" Tag="{loc:Loc Ui.Main.Wads.SearchPlaceholder}"
                             Text="{Binding WadSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

                    <TreeView Grid.Row="3" BorderThickness="0" Background="Transparent" Margin="0,2,0,0"
                              ItemsSource="{Binding WadRoots}"
                              SelectedItemChanged="WadTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="0,0,0,0" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <CheckBox IsChecked="{Binding CheckState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="False"
                                              Margin="0,0,5,0" VerticalAlignment="Center"
                                              Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource FieldBorder}"
                                              ToolTip="{Binding CheckToolTip}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailToolTip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CountText}" FontSize="10" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 左边栏与中间栏之间的分隔条 -->
            <Thumb Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Style="{StaticResource ColumnSplitter}" DragDelta="WadSplitter_DragDelta"
                   ToolTip="{loc:Loc Ui.Main.Splitter.DragHint}" />

            <!-- 目录树 -->
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 浏览方式：单个 wad，还是按英雄/皮肤/装备等分好类的全部资源 -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Ui.Main.BrowseMode.Label}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" Height="30"
                                  ItemsSource="{Binding BrowseModes}"
                                  SelectedItem="{Binding BrowseMode, Mode=TwoWay}"
                                  ToolTip="{loc:Loc Ui.Main.BrowseMode.Hint}" />
                    </Grid>

                    <Grid Grid.Row="1" Visibility="{Binding WadMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 Tag="{loc:Loc Ui.Main.Tree.SearchPlaceholder}" />
                        <ComboBox Grid.Column="1" Height="30" Margin="8,0,0,0"
                                  ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedCategory}" />
                    </Grid>

                    <Grid Grid.Row="1" Visibility="{Binding CatalogMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{loc:Loc Ui.Main.Catalog.SearchPlaceholder}" />
                        <Button Padding="6,0" Grid.Column="1" Content="{loc:Loc Ui.Main.Catalog.Rebuild}" MinWidth="54" Height="30" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryAction}"
                                Command="{Binding RefreshCatalogCommand}"
                                ToolTip="{loc:Loc Ui.Main.Catalog.RebuildHint}" />
                    </Grid>

                    <!-- 人工保底：把选中的节点归属到某个组（英雄、系列……） -->
                    <Grid Grid.Row="2" Margin="0,6,0,0"
                          Visibility="{Binding CatalogMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Text="{Binding CatalogAssignName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{loc:Loc Ui.Main.Catalog.AssignPlaceholder}" />
                        <Button Padding="6,0" Grid.Column="1" Content="{loc:Loc Ui.Main.Catalog.Apply}" MinWidth="54" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryAction}"
                                Command="{Binding CatalogAssignGroupCommand}"
                                ToolTip="{loc:Loc Ui.Main.Catalog.AssignHint}" />
                    </Grid>

                    <TreeView Grid.Row="3" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                              Visibility="{Binding WadMode, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc Ui.Main.Menu.ExportFolder}" Command="{Binding ExportFolderCommand}" />
                                <MenuItem Header="{loc:Loc Ui.Main.Menu.ExportFile}" Command="{Binding ExportCurrentCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc Ui.Main.Menu.UseAsPrefix}" Command="{Binding UseCurrentFolderCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <CheckBox IsChecked="{Binding CheckState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="False"
                                              Margin="0,0,5,0" VerticalAlignment="Center"
                                              Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource FieldBorder}"
                                              ToolTip="{Binding CheckToolTip}" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CountText}" FontSize="10" Margin="8,0,0,0"
                                               Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- 分类树：类别 → 组 → 条目 → 目录 → 文件 -->
                    <Grid Grid.Row="3" Visibility="{Binding CatalogMode, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TreeView Grid.Row="0" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                                  Visibility="{Binding CatalogTreeVisible, Converter={StaticResource BoolToVis}}"
                                  ItemsSource="{Binding CatalogRoots}"
                                  SelectedItemChanged="CatalogTree_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="CatalogTree_PreviewMouseRightButtonDown"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Ui.Main.Menu.ExportCatalogNode}" Command="{Binding ExportCatalogCommand}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc Ui.Main.Menu.MoveToCategory}" ItemsSource="{x:Static core:CatalogSectionInfo.All}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Display}" />
                                                <Setter Property="CommandParameter" Value="{Binding Section}" />
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.CatalogSectionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Loc Ui.Main.Menu.HideFolder}" Command="{Binding CatalogHideCommand}" />
                                    <MenuItem Header="{loc:Loc Ui.Main.Menu.ResetCategory}" Command="{Binding CatalogResetCommand}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc Ui.Main.Menu.RebuildCatalog}" Command="{Binding RefreshCatalogCommand}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1"
                                                ToolTip="{Binding ToolTip}">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="{DynamicResource HintBackground}" CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Hint}" FontSize="9" Foreground="{DynamicResource WarningText}" />
                                        </Border>
                                        <TextBlock Text="{Binding CountText}" FontSize="10" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- 搜索结果覆盖整棵树 -->
                        <TreeView Grid.Row="0" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                                  Visibility="{Binding CatalogShowingSearch, Converter={StaticResource BoolToVis}}"
                                  ItemsSource="{Binding CatalogSearchRoots}"
                                  SelectedItemChanged="CatalogTree_SelectedItemChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding ToolTip}">
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Location}" FontSize="10" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="10" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <TextBlock Grid.Row="1" Text="{Binding CatalogStatus}" Margin="0,6,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="{Binding TreeSummary}" Margin="0,6,0,0" FontSize="11"
                               Visibility="{Binding WadMode, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource MutedBrush}" />
                </Grid>
            </Border>

            <!-- 中间栏与右边栏之间的分隔条 -->
            <Thumb Grid.Column="3" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Style="{StaticResource ColumnSplitter}" DragDelta="PreviewSplitter_DragDelta"
                   ToolTip="{loc:Loc Ui.Main.Splitter.DragHint}" />

            <!-- 右侧：预览 / 导出设置 -->
            <Border Grid.Column="4" Style="{StaticResource PanelCard}" Margin="0" Padding="8">
                <TabControl x:Name="RightTabs" BorderThickness="0" Background="Transparent">

                    <!-- 预览 -->
                    <TabItem Header="{loc:Loc Ui.Main.Tab.Preview}">
                        <Grid Margin="6,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Button Padding="6,0" Content="{loc:Loc Ui.Main.Export.Current}" DockPanel.Dock="Right" MinWidth="88" Height="26" FontSize="11"
                                        Style="{StaticResource SecondaryAction}"
                                        ToolTip="{loc:Loc Ui.Main.Export.CurrentHint}"
                                        Command="{Binding ExportCurrentCommand}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BodyTextBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PreviewTitle}" />
                                    <TextBlock Text="{Binding PreviewSubtitle}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PreviewSubtitle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Background="{DynamicResource WarningBackground}"
                                    BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                                    Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource WarningStrongText}" />
                            </Border>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <!-- 图片 -->
                                <Border Background="{DynamicResource HeaderBackground}" CornerRadius="6" Padding="4"
                                        Visibility="{Binding ShowImage, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                           StretchDirection="DownOnly"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <!-- 3D 模型 -->
                                <Grid Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Visibility="{Binding HasModelAssets, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Ui.Main.Model.Texture}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <ComboBox Grid.Column="1" Height="26" FontSize="11"
                                                      ItemsSource="{Binding TextureChoices}"
                                                      SelectedItem="{Binding SelectedTextureChoice}"
                                                      DisplayMemberPath="Title"
                                                      ToolTip="{Binding SelectedTextureChoice.Detail}" />
                                            <Button Grid.Column="2" Content="…" Width="26" Height="26" Margin="4,0,0,0"
                                                    FontSize="12" Style="{StaticResource SecondaryAction}"
                                                    ToolTip="{loc:Loc Ui.Main.Model.PickTexture}" Command="{Binding PickTextureCommand}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Ui.Main.Model.Skeleton}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <ComboBox Grid.Column="1" Height="26" FontSize="11"
                                                      ItemsSource="{Binding SkeletonChoices}"
                                                      SelectedItem="{Binding SelectedSkeletonChoice}"
                                                      DisplayMemberPath="Title"
                                                      ToolTip="{Binding SelectedSkeletonChoice.Detail}" />
                                            <Button Grid.Column="2" Content="…" Width="26" Height="26" Margin="4,0,0,0"
                                                    FontSize="12" Style="{StaticResource SecondaryAction}"
                                                    ToolTip="{loc:Loc Ui.Main.Model.PickSkeleton}" Command="{Binding PickSkeletonCommand}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Ui.Main.Model.Animation}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <ComboBox Grid.Column="1" Height="26" FontSize="11"
                                                      ItemsSource="{Binding AnimationChoices}"
                                                      SelectedItem="{Binding SelectedAnimationChoice}"
                                                      DisplayMemberPath="Title"
                                                      ToolTip="{Binding SelectedAnimationChoice.Detail}" />
                                            <Button Grid.Column="2" Content="…" Width="26" Height="26" Margin="4,0,0,0"
                                                    FontSize="12" Style="{StaticResource SecondaryAction}"
                                                    ToolTip="{loc:Loc Ui.Main.Model.PickAnimation}" Command="{Binding PickAnimationCommand}" />
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Padding="6,0" Content="{loc:Loc Ui.Main.Play}" MinWidth="62" Height="26" FontSize="11"
                                                        Style="{StaticResource PrimaryAction}"
                                                        Command="{Binding PlayAnimationCommand}" />
                                                <Button Padding="6,0" Content="{loc:Loc Ui.Main.Stop}" MinWidth="62" Height="26" Margin="6,0,0,0" FontSize="11"
                                                        Style="{StaticResource SecondaryAction}"
                                                        Command="{Binding StopAnimationCommand}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AnimationStatus}" FontSize="10"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding AnimationStatus}" />
                                        </Grid>

                                        <!-- 每个子网格分到的贴图（多贴图皮肤才有） -->
                                        <TextBlock Text="{Binding TextureBindingNote}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TextureBindingNote}"
                                                   Visibility="{Binding HasTextureBinding, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <controls:ModelPreviewView Grid.Row="1" Margin="0,6,0,0"
                                                               Model="{Binding PreviewModel}" />
                                </Grid>

                                <!-- 音频 -->
                                <DockPanel Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVis}}">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding AudioStatus}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                                        <Button Padding="6,0" Content="{loc:Loc Ui.Main.Audio.DownloadTool}" Height="28" FontSize="11"
                                                Margin="0,0,0,4"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding DownloadAudioToolCommand}"
                                                Visibility="{Binding AudioToolMissing, Converter={StaticResource BoolToVis}}" />
                                        <Button Padding="6,0" Content="{loc:Loc Ui.Main.Audio.DownloadSpeechModel}" Height="28" FontSize="11"
                                                Margin="0,0,0,4"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding DownloadSpeechModelCommand}"
                                                Visibility="{Binding SpeechModelMissing, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Padding="6,0" Content="{loc:Loc Ui.Main.Play}" MinWidth="62" Style="{StaticResource PrimaryAction}"
                                                    Command="{Binding PlayAudioCommand}" />
                                            <Button Padding="6,0" Content="{loc:Loc Ui.Main.Stop}" MinWidth="54" Margin="6,0,0,0" FontSize="11"
                                                    Style="{StaticResource SecondaryAction}"
                                                    Command="{Binding StopAudioCommand}" />
                                            <Button Padding="6,0" Content="{loc:Loc Ui.Main.Audio.Transcribe}" MinWidth="62" Margin="12,0,0,0" FontSize="11"
                                                    Style="{StaticResource PrimaryAction}"
                                                    ToolTip="{loc:Loc Ui.Main.Audio.TranscribeHint}"
                                                    Command="{Binding TranscribeCommand}" />
                                            <Button Padding="6,0" Content="{loc:Loc Ui.Main.Audio.TranscribeAll}" MinWidth="76" Margin="6,0,0,0" FontSize="11"
                                                    Style="{StaticResource SecondaryAction}"
                                                    ToolTip="{loc:Loc Ui.Main.Audio.TranscribeAllHint}"
                                                    Command="{Binding TranscribeAllCommand}" />
                                            <Button Padding="6,0" Content="{loc:Loc Ui.Main.Audio.CancelTranscribe}" MinWidth="76" Margin="6,0,0,0" FontSize="11"
                                                    Command="{Binding CancelTranscribeCommand}"
                                                    Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource SecondaryAction}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SpeechStatus}" FontSize="10" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />

                                        <TextBlock Text="{loc:Loc Ui.Main.Audio.NoteLabel}" Style="{StaticResource FieldLabel}"
                                                   Margin="0,8,0,2" />
                                        <TextBox Height="52" FontSize="11" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding SelectedNote, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 Tag="{loc:Loc Ui.Main.Audio.NotePlaceholder}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding AudioTracks}"
                                             SelectedItem="{Binding SelectedAudioTrack}"
                                             BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}" FontSize="11"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontFamily="Consolas" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="10"
                                                               Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center"
                                                               Margin="12,0,0,0" />
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NotePreview}"
                                                               FontSize="10" Margin="0,1,0,0" Foreground="{DynamicResource TertiaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Note}"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!-- 文本 -->
                                <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                         Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"
                                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         BorderBrush="{DynamicResource PanelBorder}" Background="{DynamicResource SubtleBackground}" />

                                <!-- JSON：格式化、可搜索、点路径跳转 -->
                                <controls:JsonViewer Text="{Binding PreviewJson}"
                                                     Visibility="{Binding ShowJson, Converter={StaticResource BoolToVis}}"
                                                     LinkActivated="JsonViewer_LinkActivated" />

                                <!-- 十六进制 -->
                                <TextBox Text="{Binding PreviewHex, Mode=OneWay}" IsReadOnly="True"
                                         Visibility="{Binding ShowHex, Converter={StaticResource BoolToVis}}"
                                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         BorderBrush="{DynamicResource PanelBorder}" Background="{DynamicResource SubtleBackground}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 导出设置 -->
                    <TabItem Header="{loc:Loc Ui.Main.Tab.Export}">
                        <Grid Margin="6,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 设置区（可滚动） -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{loc:Loc Ui.Main.Export.Scope}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                    <ComboBox Height="28" ItemsSource="{Binding ExportScopes}"
                                              DisplayMemberPath="Display"
                                              SelectedIndex="{Binding ExportScopeIndex}" />

                                    <TextBlock Text="{loc:Loc Ui.Main.Export.OutputFolder}" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button Content="{loc:Loc Ui.Main.Export.Browse}" DockPanel.Dock="Right" MinWidth="60" Padding="6,0" Height="28"
                                                Margin="6,0,0,0" Style="{StaticResource SecondaryAction}"
                                                Command="{Binding BrowseOutputCommand}" />
                                        <TextBox Height="28" VerticalContentAlignment="Center"
                                                 Style="{StaticResource PlaceholderTextBox}"
                                                 Text="{Binding OutputRootText, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="{loc:Loc Ui.Main.Export.OutputPlaceholder}" />
                                    </DockPanel>

                                    <TextBlock Text="{loc:Loc Ui.Main.Export.Categories}" Style="{StaticResource FieldLabel}" />
                                    <ItemsControl ItemsSource="{Binding ExportCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Display}"
                                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="12" Margin="0,0,14,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="{loc:Loc Ui.Main.Export.SelectAll}" MinWidth="52" Height="26" FontSize="11" Padding="6,0"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding SelectAllCategoriesCommand}" />
                                        <Button Content="{loc:Loc Ui.Main.Export.SelectNone}" MinWidth="60" Height="26" Margin="6,0,0,0" FontSize="11" Padding="6,0"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding SelectNoCategoriesCommand}" />
                                        <Button Content="{loc:Loc Ui.Main.Export.OnlyTextures}" MinWidth="62" Height="26" Margin="12,0,4,0" FontSize="11" Padding="6,0"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding SelectCategoryPresetCommand}" CommandParameter="texture" />
                                        <Button Content="{loc:Loc Ui.Main.Export.OnlyModels}" MinWidth="62" Height="26" Margin="0,0,4,0" FontSize="11" Padding="6,0"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding SelectCategoryPresetCommand}" CommandParameter="model" />
                                        <Button Content="{loc:Loc Ui.Main.Export.OnlyAudio}" MinWidth="62" Height="26" Margin="0,0,0,0" FontSize="11" Padding="6,0"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource SecondaryAction}"
                                                Command="{Binding SelectCategoryPresetCommand}" CommandParameter="audio" />
                                    </WrapPanel>

                                    <TextBlock Text="{loc:Loc Ui.Main.Export.PrefixLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button Padding="6,0" Content="{loc:Loc Ui.Main.Export.UseCurrentFolder}" DockPanel.Dock="Right" MinWidth="82" Height="28"
                                                Margin="6,0,0,0" FontSize="11" Style="{StaticResource SecondaryAction}"
                                                Command="{Binding UseCurrentFolderCommand}" />
                                        <TextBox Height="28" VerticalContentAlignment="Center"
                                                 Style="{StaticResource PlaceholderTextBox}"
                                                 Text="{Binding ExportPathPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="{loc:Loc Ui.Main.Export.PrefixPlaceholder}" />
                                    </DockPanel>

                                    <!-- 路径过滤与扩展名并排，省出一行高度 -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{loc:Loc Ui.Main.Export.PatternLabel}" Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"
                                                   ToolTip="{loc:Loc Ui.Main.Export.PatternHint}" />
                                        <TextBlock Grid.Column="2" Text="{loc:Loc Ui.Main.Export.ExtensionsLabel}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,3"
                                                   ToolTip="{loc:Loc Ui.Main.Export.ExtensionsHint}" />
                                        <TextBox Grid.Row="1" Height="28" VerticalContentAlignment="Center"
                                                 Style="{StaticResource PlaceholderTextBox}"
                                                 Text="{Binding ExportPattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="*skins/base/*" ToolTip="{loc:Loc Ui.Main.Export.EmptyMeansAll}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Height="28" VerticalContentAlignment="Center"
                                                 Style="{StaticResource PlaceholderTextBox}"
                                                 Text="{Binding ExportExtensions, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="skn,skl,tex" ToolTip="{loc:Loc Ui.Main.Export.EmptyMeansAll}" />
                                    </Grid>

                                    <!-- 线程数与音频格式并排，省出一行高度 -->
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Ui.Main.Export.Threads}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBox Grid.Column="1" Height="28" Margin="8,0,0,0" FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource PlaceholderTextBox}" Tag="16"
                                                 Text="{Binding ThreadCount, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="{loc:Loc Ui.Main.Export.AudioFormat}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <ComboBox Grid.Column="3" Height="28" Margin="8,0,0,0" FontSize="12"
                                                  ItemsSource="{Binding AudioFormats}"
                                                  SelectedItem="{Binding SelectedAudioFormat}"
                                                  DisplayMemberPath="Display" />
                                    </Grid>

                                    <!-- 选项：三列两行 -->
                                    <!-- 选项自动换行：英文比中文长，三列固定宽度会挤成半截 -->
                                    <WrapPanel Margin="0,5,0,0">
                                        <CheckBox Content="{loc:Loc Ui.Main.Export.OptionGroupByWad}" FontSize="12" Margin="0,0,14,2"
                                                  ToolTip="{loc:Loc Ui.Main.Export.OptionGroupByWadHint}"
                                                  IsChecked="{Binding OptionGroupByWad}" />
                                        <CheckBox Content="{loc:Loc Ui.Main.Export.OptionFlat}" FontSize="12" Margin="0,0,14,2"
                                                  ToolTip="{loc:Loc Ui.Main.Export.OptionFlatHint}"
                                                  IsChecked="{Binding OptionFlat}" />
                                        <CheckBox Content="{loc:Loc Ui.Main.Export.OptionSkipExisting}" FontSize="12" Margin="0,0,14,2"
                                                  ToolTip="{loc:Loc Ui.Main.Export.OptionSkipExistingHint}"
                                                  IsChecked="{Binding OptionSkipExisting}" />
                                        <CheckBox Content="{loc:Loc Ui.Main.Export.OptionIncludeUnnamed}" FontSize="12" Margin="0,0,14,2"
                                                  ToolTip="{loc:Loc Ui.Main.Export.OptionIncludeUnnamedHint}"
                                                  IsChecked="{Binding OptionIncludeUnnamed}" />
                                        <CheckBox FontSize="12" Margin="0,0,14,2"
                                                  Content="{loc:Loc Ui.Main.Export.OptionConvertTextures}"
                                                  ToolTip="{loc:Loc Ui.Main.Export.OptionConvertTexturesHint}"
                                                  IsChecked="{Binding OptionConvertTextures}" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 主操作（固定在设置区下方，不用滚动就能点到） -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Padding="6,0" Content="{loc:Loc Ui.Main.Export.Start}" Height="34" Style="{StaticResource PrimaryAction}"
                                        Command="{Binding ExportCommand}"
                                        ToolTip="{loc:Loc Ui.Main.Export.StartHint}" />
                                <Button Padding="6,0" Grid.Column="1" Content="{loc:Loc Ui.Main.Export.OpenOutput}" Height="34" Margin="8,0,0,0"
                                        FontSize="12" Style="{StaticResource SecondaryAction}"
                                        Command="{Binding OpenOutputCommand}" />
                            </Grid>

                            <!-- 进度区 -->
                            <Border Grid.Row="2" Margin="0,6,0,0" Padding="10,6" CornerRadius="6"
                                    Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Ui.Main.Export.Progress}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                                                   FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>

                                    <ProgressBar Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource ProgressTrack}" BorderThickness="0">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle x:Name="PART_Track" />
                                                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                                   Fill="{TemplateBinding Foreground}"
                                                                   RadiusX="4" RadiusY="4" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                        <Button Padding="6,0" Grid.Column="1" Content="{loc:Loc Ui.Main.Export.Cancel}" MinWidth="70" Height="26" FontSize="11"
                                                Margin="8,0,0,0" Style="{StaticResource SecondaryAction}"
                                                Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 日志 -->
                    <TabItem Header="{loc:Loc Ui.Main.Tab.Log}">
                        <Grid Margin="6,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Ui.Main.Log.Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                           Margin="0" />
                                <Button Padding="6,0" Grid.Column="1" Content="{loc:Loc Ui.Main.Log.Clear}" MinWidth="52" Height="24" FontSize="11"
                                        Style="{StaticResource SecondaryAction}"
                                        Command="{Binding ClearLogCommand}" />
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}"
                                     FontSize="11" Background="{DynamicResource SubtleBackground}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 关于：只列声明，点关闭回到原界面 -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10" Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="560" Padding="22,18" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Ui.Main.About.Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding AboutText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                               LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="{loc:Loc Ui.Main.About.ProjectUrl}" />
                        <Hyperlink NavigateUri="https://github.com/liveldy/DawnResourceExtractionTool"
                                   Foreground="{DynamicResource AccentBrush}"
                                   RequestNavigate="AboutLink_RequestNavigate">GitHub liveldy</Hyperlink>
                    </TextBlock>
                    <Button Padding="6,0" Content="{loc:Loc Ui.Main.About.Close}" MinWidth="72" Height="30" Margin="0,16,0,0" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryAction}" Command="{Binding CloseAboutCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
