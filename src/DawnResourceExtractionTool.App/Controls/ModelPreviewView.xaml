<UserControl x:Class="DawnResourceExtractionTool.App.Controls.ModelPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:loc="clr-namespace:DawnResourceExtractionTool.App.Localization">
    <Grid Background="{DynamicResource HeaderBackground}">
        <h:HelixViewport3D x:Name="Viewport"
                           Background="{DynamicResource ViewportBackground}"
                           ShowCoordinateSystem="False"
                           ShowViewCube="False"
                           IsHeadLightEnabled="False"
                           ZoomExtentsWhenLoaded="False"
                           RotationSensitivity="1"
                           ZoomSensitivity="1">
            <ModelVisual3D x:Name="Visual" />
        </h:HelixViewport3D>

        <Button x:Name="ResetViewButton"
                Content="{loc:Loc Ui.ModelPreview.ResetView}"
                FontSize="11"
                Foreground="{DynamicResource TertiaryTextBrush}"
                Background="{DynamicResource ViewportOverlay}"
                BorderBrush="{DynamicResource ViewportBorder}"
                Padding="8,3"
                Margin="8"
                Cursor="Hand"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Click="ResetViewClick" />

        <TextBlock x:Name="Hint" Text="{loc:Loc Ui.ModelPreview.Hint}"
                   FontSize="11" Foreground="{DynamicResource PlaceholderBrush}" Margin="8"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
