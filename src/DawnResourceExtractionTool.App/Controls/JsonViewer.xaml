<UserControl x:Class="DawnResourceExtractionTool.App.Controls.JsonViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:loc="clr-namespace:DawnResourceExtractionTool.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HintText" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource PlaceholderBrush}" TextTrimming="CharacterEllipsis"
                       Text="{loc:Loc Ui.JsonViewer.Hint}" />
            <Button Grid.Column="1" x:Name="ModeButton" Content="{loc:Loc Ui.JsonViewer.RawMode}" Width="54" Height="22"
                    FontSize="10" Padding="0" VerticalContentAlignment="Center"
                    Click="ModeButton_Click"
                    ToolTip="{loc:Loc Ui.JsonViewer.ModeHint}" />
        </Grid>

        <avalonedit:TextEditor Grid.Row="1" x:Name="Editor"
                               FontFamily="Consolas" FontSize="11"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                               Background="{DynamicResource FieldBackground}"
                               IsReadOnly="True"
                               ShowLineNumbers="True" />
    </Grid>
</UserControl>
